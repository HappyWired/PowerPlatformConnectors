    "/computeDataFunction": {
      "post": {
        "operationId": "ComputeDataFunction",
        "summary": "Compute data",
        "description": "Compute data using expression, calculated columns and filtering",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "schema": {
              "type": "object",
              "properties": {
                "expression": {
                  "type": "string",
                  "x-ms-summary": "Expression",
                  "description": "For example, Sum(quantity)"
                },
                "Data": {
                  "type": "array",
                  "x-ms-summary": "Data",
                  "description": "Array of data",
                  "items": {
                    "type": "object"
                  }
                },
                "filter": {
                  "type": "string",
                  "x-ms-summary": "Filter"
                },
                "CalculatedColumns": {
                  "type": "array",
                  "x-ms-summary": "Calculated Columns",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "x-ms-summary": "Name"
                      },
                      "type": {
                        "type": "string",
                        "x-ms-summary": "Type",
                        "enum": [
                          "String",
                          "Integer",
                          "Decimal",
                          "DateTime"
                        ]
                      },
                      "expression": {
                        "type": "string",
                        "x-ms-summary": "Expression",
                        "description": "For example, quantity*price"
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "type": "object",
                  "x-ms-summary": "Result"
                }
              }
            }
          }
        }
